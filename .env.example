# InstantDB app id from https://instantdb.com/dash
NEXT_PUBLIC_INSTANT_APP_ID=

# Admin token from app Settings in Instant dashboard (for `npm run seed:instant` only).
# NOT the app id — a wrong value here breaks `npm run instant:push`.
INSTANT_APP_ADMIN_TOKEN=

# Comma-separated emails allowed to access /dashboard (seeded via npm run seed:instant)
DASHBOARD_ADMIN_EMAILS=

# Google Gemini API key for dashboard menu translation (server-side only)
GEMINI_API_KEY=
